.row{display:flex;gap:12px;margin-top:12px}
.box{flex:1;background:#222;border-radius:12px;padding:14px;text-align:center}
.big{font-size:32px;font-weight:800}
button{width:100%;margin-top:12px;padding:14px;font-size:16px;border:0;border-radius:12px;background:#333;color:#eee}
ul{list-style:none;padding:0;margin:8px 0 0}
li{background:#222;border-radius:8px;padding:10px;margin-bottom:6px;display:flex;justify-content:space-between}
</style></head><body>
<h1>&#9888;&#65039; Machine Zone Safety Monitor</h1>
<div id="card"><div id="zone">--</div><div id="dist">connecting...</div></div>
<div class="row">
  <div class="box"><div class="big" id="n">0</div>near-misses</div>
  <div class="box"><div class="big" id="up">0:00</div>shift time</div>
</div>
<button onclick="fetch('/mute')">Acknowledge alarm</button>
<h1 style="margin-top:20px">Near-miss log</h1>
<ul id="log"><li>No events yet</li></ul>
<button onclick="if(confirm('Reset shift data?'))fetch('/reset')">Reset shift data</button>
<script>
