#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

const int TRIG_PIN    = 4;
const int ECHO_PIN    = 5;
const int SERVO_PIN   = 6;
const int BUTTON_PIN  = 7;
const int SDA_PIN     = 8;
const int SCL_PIN     = 9;
const int RED_PIN     = 15;
const int YELLOW_PIN  = 16;
const int GREEN_PIN   = 17;
const int SPEAKER_PIN = 18;

const float WARNING_CM = 60.0;
const float DANGER_CM  = 30.0;
const int BARRIER_UP   = 0;
const int BARRIER_DOWN = 90;
const char* WIFI_NAME  = "SafetyMonitor";
const char* WIFI_PASS  = "howdyhack26";

const int SERVO_CH   = 0;
const int SPEAKER_CH = 2;

Adafruit_SSD1306 display(128, 64, &Wire, -1);
bool oledOK = false;
WebServer server(80);

enum Zone { SAFE, WARNING, DANGER };
Zone zone = SAFE;
float distanceCm = 999;
unsigned long nearMisses = 0;
bool muted = false;

const int LOG_SIZE = 10;
unsigned long logTime[LOG_SIZE];
float logDist[LOG_SIZE];
int logCount = 0;

unsigned long lastRead = 0, lastBeep = 0, lastOled = 0, lastButton = 0;
bool beepOn = false;

const char PAGE[] PROGMEM = R"rawliteral(
<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Safety Monitor</title>
<style>
body{margin:0;font-family:system-ui,sans-serif;background:#111;color:#eee;padding:16px}
