const char* zoneName(Zone z) {
  if (z == DANGER)  return "DANGER";
  if (z == WARNING) return "WARNING";
  return "SAFE";
}

void setServo(int angle) {
  int us = map(angle, 0, 180, 500, 2400);
  ledcWrite(SERVO_PIN, (uint32_t)us * 16383 / 20000);
}

void speaker(int freq) {
  ledcWriteTone(SPEAKER_PIN, freq);
}

float readOnce() {
  digitalWrite(TRIG_PIN, LOW);  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH); delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  unsigned long us = pulseIn(ECHO_PIN, HIGH, 25000);
  if (us == 0) return 999;
  return us / 58.0;
}

float readDistance() {
  float a = readOnce(); delay(5);
  float b = readOnce(); delay(5);
  float c = readOnce();
  return max(min(a, b), min(max(a, b), c));
}

void addLog(float d) {
  for (int i = LOG_SIZE - 1; i > 0; i--) { logTime[i] = logTime[i-1]; logDist[i] = logDist[i-1]; }
  logTime[0] = millis(); logDist[0] = d;
  if (logCount < LOG_SIZE) logCount++;
}

void updateLights() {
  digitalWrite(GREEN_PIN,  zone == SAFE);
  digitalWrite(YELLOW_PIN, zone == WARNING);
  digitalWrite(RED_PIN,    zone == DANGER);
}

void updateAlarm() {
  unsigned long now = millis();
  if (zone == DANGER && !muted) {
    if (now - lastBeep > 150) { lastBeep = now; beepOn = !beepOn; speaker(beepOn ? 2500 : 0); }
  } else if (zone == WARNING) {
    if (!beepOn && now - lastBeep > 1000) { lastBeep = now; beepOn = true; speaker(1200); }
    else if (beepOn && now - lastBeep > 60) { beepOn = false; speaker(0); }
  } else if (beepOn) { beepOn = false; speaker(0); }
}

void updateOled() {
  if (!oledOK) return;
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(2); display.setCursor(0, 0); display.println(zoneName(zone));
  display.setTextSize(1); display.setCursor(0, 24);
  if (distanceCm >= 999) display.println("Distance: --");
  else { display.print("Distance: "); display.print(distanceCm, 0); display.println(" cm"); }
  display.print("Near-misses: "); display.println(nearMisses);
  display.setCursor(0, 54);
  display.print(muted ? "ALARM ACKNOWLEDGED" : "WiFi: SafetyMonitor");
  display.display();
}

void checkButton() {
  if (digitalRead(BUTTON_PIN) == LOW && millis() - lastButton > 300) {
    lastButton = millis();
    if (zone == DANGER) muted = true;
  }
}

void handleData() {
  String j = "{\"d\":" + String(distanceCm >= 999 ? -1.0f : distanceCm, 1);
  j += ",\"z\":\"" + String(zoneName(zone)) + "\"";
  j += ",\"n\":" + String(nearMisses);
  j += ",\"m\":" + String(muted ? "true" : "false");
  j += ",\"up\":" + String(millis());
  j += ",\"log\":[";
  for (int i = 0; i < logCount; i++) {
    if (i) j += ",";
    j += "{\"t\":" + String(logTime[i]) + ",\"d\":" + String(logDist[i], 1) + "}";
  }
  j += "]}";
  server.send(200, "application/json", j);
}

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("Warehouse Safety Monitor starting...");

  pinMode(TRIG_PIN, OUTPUT); pinMode(ECHO_PIN, INPUT);
  pinMode(RED_PIN, OUTPUT); pinMode(YELLOW_PIN, OUTPUT); pinMode(GREEN_PIN, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  ledcAttachChannel(SERVO_PIN, 50, 14, SERVO_CH);
  ledcAttachChannel(SPEAKER_PIN, 2000, 8, SPEAKER_CH);
  speaker(0);
  setServo(BARRIER_UP);

  Wire.begin(SDA_PIN, SCL_PIN);
  oledOK = display.begin(SSD1306_SWITCHCAPVCC, 0x3C);

  WiFi.softAP(WIFI_NAME, WIFI_PASS);
  Serial.print("Dashboard: http://"); Serial.println(WiFi.softAPIP());

  server.on("/", []() { server.send_P(200, "text/html", PAGE); });
  server.on("/data", handleData);
  server.on("/reset", []() { nearMisses = 0; logCount = 0; server.send(200, "text/plain", "ok"); });
  server.on("/mute", []() { if (zone == DANGER) muted = true; server.send(200, "text/plain", "ok"); });
  server.begin();

  digitalWrite(GREEN_PIN, HIGH);  delay(200);
  digitalWrite(YELLOW_PIN, HIGH); delay(200);
  digitalWrite(RED_PIN, HIGH);
  speaker(1500); delay(150); speaker(0);
  setServo(BARRIER_DOWN); delay(500);
  setServo(BARRIER_UP);   delay(300);
  digitalWrite(GREEN_PIN, LOW); digitalWrite(YELLOW_PIN, LOW); digitalWrite(RED_PIN, LOW);
}

void loop() {
  server.handleClient();
  checkButton();

  if (millis() - lastRead > 100) {
    lastRead = millis();
    distanceCm = readDistance();

    Zone newZone = SAFE;
    if (distanceCm < DANGER_CM || (zone == DANGER && distanceCm < DANGER_CM + 5)) newZone = DANGER;
    else if (distanceCm < WARNING_CM || (zone == WARNING && distanceCm < WARNING_CM + 5)) newZone = WARNING;

    if (newZone == DANGER && zone != DANGER) {
      nearMisses++; addLog(distanceCm);
      Serial.printf("NEAR-MISS #%lu at %.0f cm\n", nearMisses, distanceCm);
    }
    if (newZone != DANGER) muted = false;
    if (newZone != zone) setServo(newZone == DANGER ? BARRIER_DOWN : BARRIER_UP);

    zone = newZone;
    updateLights();
    Serial.printf("Distance: %.1f cm   Zone: %s\n", distanceCm, zoneName(zone));
  }

  updateAlarm();
  if (millis() - lastOled > 250) { lastOled = millis(); updateOled(); }
}
