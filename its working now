function fmt(ms){let s=Math.floor(ms/1000),m=Math.floor(s/60);return m+':'+String(s%60).padStart(2,'0')}
async function tick(){
  try{
    const d=await (await fetch('/data')).json();
    document.getElementById('zone').textContent=d.z+(d.m?' (ack)':'');
    document.getElementById('card').style.background=colors[d.z];
